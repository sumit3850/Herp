{
  "id": "herpwatch-console",
  "name": "HerpWatch Console: review & checklists",
  "short_name": "HW Console",
  "description": "Review submissions, manage core checklists, species, users and packs.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f7f8f4",
  "theme_color": "#16231c",
  "icons": [
    { "src": "../assets/icon-console-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "../assets/icon-console-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "../assets/icon-console.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Submissions to review", "url": "./#/submissions?status=pending" },
    { "name": "Core checklists", "url": "./#/checklists" }
  ]
}
